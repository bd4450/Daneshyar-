<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>دانشیار</title>
  <meta name="theme-color" content="#0f172a" />
  <link rel="manifest" href="manifest.json" />
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <header class="topbar">
    <h1 id="app-title">دانشیار</h1>
    <div class="top-actions">
      <button id="lang-toggle">EN</button>
      <button id="theme-toggle">🌙</button>
    </div>
  </header>

  <main class="container">
    <section class="hero">
      <h2 id="hero-title">دانشنامه همراه شما</h2>
      <p id="hero-subtitle">جستجو در اطلاعات عمومی و مدخل‌های دانشنامه</p>
    </section>

    <section class="search-box">
      <input
        type="text"
        id="search-input"
        placeholder="جستجو..."
      />
    </section>

    <section class="categories">
      <h3 id="category-title">دسته‌بندی‌ها</h3>
      <div id="category-list" class="category-list"></div>
    </section>

    <section class="results">
      <h3 id="results-title">مدخل‌ها</h3>
      <div id="entries-list" class="entries-list"></div>
    </section>

    <section class="favorites">
      <h3 id="favorites-title">علاقه‌مندی‌ها</h3>
      <div id="favorites-list" class="entries-list"></div>
    </section>
  </main>

  <script src="app.js"></script>
</body>
</html>
